{
  "name": "loodka-poopka",
  "version": "0.1.0",
  "private": true,
  "description": "Эксперимент по прогнозированию матчей CS2: расширение-подсказчик и инструменты разбора линии",
  "workspaces": [
    "extension",
    "tools"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter @lp/extension build",
    "dev": "bun run --filter @lp/extension dev",
    "test": "bun test",
    "typecheck": "bun run --filter @lp/extension typecheck && bun run --filter @lp/tools typecheck",
    "parse": "bun run tools/parse-bets.ts",
    "scan": "bun run tools/scan-secrets.ts",
    "scan:all": "bun run tools/scan-secrets.ts --all",
    "hook:install": "bun run tools/scan-secrets.ts --install",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@artemiy/oxfmt-allman": "0.62.0",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
